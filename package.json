{
  "name": "pulldasher",
  "version": "0.0.1",
  "description": "Simple pull request dashboard",
  "dependencies": {
    "@octokit/plugin-retry": "^7.2.1",
    "@octokit/plugin-throttling": "^9.4.0",
    "@octokit/rest": "^21.1.0",
    "@types/underscore": "^1.10.24",
    "bluebird": "^3.7.1",
    "body-parser": "^1.20.5",
    "debug": "^4.3.4",
    "express": "^4.22.2",
    "express-session": "^1.18.2",
    "mysql2": "^3.11.0",
    "notify-queue": "0.0.5",
    "passport": "^0.6.0",
    "passport-github2": "^0.1.12",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.3",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.2.0",
    "@typescript-eslint/parser": "^5.2.0",
    "eslint": "^8.12.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-react": "^7.29.4",
    "husky": "^7.0.4",
    "lint-staged": "^12.3.7",
    "prettier": "2.7.1",
    "typescript": "^4.1.3"
  },
  "scripts": {
    "start": "node app.js",
    "debug": "node inspect app.js",
    "lint": "eslint ./",
    "postinstall": "npm run build",
    "build": "cd frontend-v2 && npm ci && npm run build",
    "frontend:dev": "cd frontend-v2 && npm run dev",
    "frontend:dummy": "cd frontend-v2 && npm run dev:dummy",
    "test": "CONFIG_PATH=../test/fixtures/config.js node --test test/*.test.js",
    "precommit": "lint-staged"
  },
  "lint-staged": {
    "*.(js|jsx|ts|tsx)": [
      "eslint --fix"
    ]
  },
  "main": "app.js",
  "repository": "git@github.com:ifixit/pulldasher.git",
  "author": "iFixit",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
