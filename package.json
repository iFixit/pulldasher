{
  "name": "pulldasher",
  "version": "0.0.1",
  "description": "Simple pull request dashboard",
  "dependencies": {
    "@chakra-ui/react": "^1.8.6",
    "@emotion/react": "^11.8.1",
    "@emotion/styled": "^11.8.1",
    "@fortawesome/fontawesome-svg-core": "^6.1.1",
    "@fortawesome/free-solid-svg-icons": "^6.0.0",
    "@fortawesome/react-fontawesome": "^0.1.17",
    "@octokit/plugin-retry": "^7.2.1",
    "@octokit/plugin-throttling": "^9.4.0",
    "@octokit/rest": "^21.1.0",
    "@types/underscore": "^1.10.24",
    "bluebird": "^3.7.1",
    "body-parser": "^2.3.0",
    "debug": "^4.3.4",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "framer-motion": "^4.1.17",
    "lodash-es": "^4.18.1",
    "mysql2": "^3.11.0",
    "notify-queue": "0.0.5",
    "passport": "^0.6.0",
    "passport-github2": "^0.1.12",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-hotkeys-hook": "^3.4.4",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.3",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.12.11",
    "@babel/preset-react": "^7.12.10",
    "@types/lodash-es": "^4.17.6",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "^5.2.0",
    "@typescript-eslint/parser": "^5.2.0",
    "babel-loader": "^8.2.3",
    "css-loader": "^6.7.1",
    "esbuild": "^0.28.1",
    "eslint": "^8.12.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-react": "^7.29.4",
    "eslint-webpack-plugin": "^3.1.1",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^7.0.4",
    "less": "^4.1.2",
    "less-loader": "^10.2.0",
    "lint-staged": "^12.3.7",
    "prettier": "2.7.1",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.2.8",
    "typescript": "^4.1.3",
    "webpack": "5.105",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.0.0"
  },
  "scripts": {
    "start": "node app.js",
    "debug": "node inspect app.js",
    "lint": "eslint ./",
    "postinstall": "npm run build:shared && npm run build && npm run build:v2",
    "build": "webpack --config ./frontend/webpack.prod.config.js",
    "build:v2": "cd frontend-v2 && npm ci && npm run build",
    "build:shared": "esbuild shared/index.ts --bundle --platform=node --format=esm --outfile=shared/dist/index.js",
    "v1:dev": "DUMMY_USER=danielbeardsley DUMMY_PULLS=./frontend/dummy-pulls.json webpack-dev-server --config ./frontend/webpack.dev.config.js",
    "v1:watch": "webpack --watch --config ./frontend/webpack.dev.config.js",
    "frontend:dev": "cd frontend-v2 && npm run dev",
    "frontend:dummy": "cd frontend-v2 && npm run dev:dummy",
    "test": "CONFIG_PATH=../test/fixtures/config.js node --test test/*.test.js",
    "precommit": "lint-staged"
  },
  "lint-staged": {
    "*.(js|jsx|ts|tsx)": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "@types/lodash": "4.14.181"
  },
  "main": "app.js",
  "repository": "git@github.com:ifixit/pulldasher.git",
  "author": "iFixit",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
